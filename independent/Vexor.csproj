    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VEXOR</AssemblyName>
    <RootNamespace>VEXOR</RootNamespace>
    <Version>0.1.0</Version>
    <Product>VEXOR Account Studio</Product>
    <Description>Independent VEXOR account profile manager</Description>
  </PropertyGroup>
</Project>
